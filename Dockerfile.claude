# Full integration test: Claude Code + agent-repl
FROM python:3.11-slim

# Install Node.js and npm (required for Claude Code and MCP servers)
RUN apt-get update && apt-get install -y \
    curl \
    git \
    && curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y nodejs \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Install Claude Code globally (as root)
RUN npm install -g @anthropic-ai/claude-code

# Create non-root user
RUN useradd -m -s /bin/bash testuser
USER testuser
WORKDIR /home/testuser

# Install agent-repl from GitHub
RUN pip install --user git+https://github.com/eran-broder/agent-repl.git

# Add local bin to PATH
ENV PATH="/home/testuser/.local/bin:${PATH}"

# Create MCP config with filesystem server
RUN mkdir -p /home/testuser/.claude && \
    echo '{"mcpServers": {"filesystem": {"type": "stdio", "command": "npx", "args": ["-y", "@modelcontextprotocol/server-filesystem", "/home/testuser"]}}}' > /home/testuser/.claude.json

# Create test directory
RUN mkdir -p /home/testuser/testdata && \
    echo "Hello from Docker test file" > /home/testuser/testdata/hello.txt

# Verify installations
RUN echo "=== Verifying installations ===" && \
    which repl && \
    repl --help && \
    which claude && \
    claude --version

CMD ["bash"]
